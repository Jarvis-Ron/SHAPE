{
  "schema": "shape_learned_context_release_v1",
  "model": "SHAPE",
  "variant": {
    "weighted_rank": true,
    "lambda": 0,
    "kappa": 0
  },
  "frozen_landing": {
    "scale_mode": "rank",
    "selection_mode": "sample",
    "selection_temperature": 0.75,
    "distance_mode": "mixture",
    "distance_tau": 1.25,
    "attraction_mode": "raw",
    "attraction_strength": 1.0,
    "revisit_beta": 1.0,
    "landing_temperature": 1.0,
    "attribute_top_k": 50,
    "anchor_top_k": 2,
    "home_context_neighbors": 25,
    "candidate_top_k": 512,
    "candidate_omitted_mass_tolerance": 0.0001,
    "candidate_audit_steps": 128
  },
  "sampling": {
    "landing_seeds": [
      42,
      43,
      44,
      45,
      46
    ]
  },
  "evaluation": {
    "protocol": "equal_complete_users_v1",
    "primary_stratum": "events_ge_2",
    "repeats": 200,
    "spatial_granularity": "od_100x100",
    "aggregation": "metric_per_equal_user_draw_then_mean_per_seed",
    "uncertainty": "sample_SD_across_five_generation_seed_means",
    "std_ddof": 1
  },
  "information": {
    "behavior": "observed_source_codes_and_source_event_schedule",
    "prototype_semantics": "source_train",
    "target_map": "complete_static_grid_vocabulary_and_raw_POI_counts",
    "target_checkins_for_generation": "population_home_quota_only",
    "target_distance_calibration": false,
    "target_test": "equal_complete_user_evaluation_only",
    "pareto_distance_cost": false,
    "tokenizer_training_contract": "residual_fsq_no_layer_semantics_no_aux_v3"
  },
  "learned_overrides": {
    "required": [
      "learned_landing_checkpoint",
      "learned_context_checkpoint"
    ],
    "note": "frozen_landing preserves head/interface initialization; fitted scoring, home context, initial counts and quantile bounds override their initial values"
  }
}
